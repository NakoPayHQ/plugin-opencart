<div class="mb-3">
  {% if description %}
  <p>{{ description }}</p>
  {% endif %}
  <div class="text-end">
    <button type="button" id="button-nakopay-confirm" class="btn btn-primary">
      <i class="fa-brands fa-bitcoin"></i> Pay with Crypto
    </button>
  </div>
</div>

<script type="text/javascript">
$('#button-nakopay-confirm').on('click', function() {
    var btn = $(this);
    btn.prop('disabled', true).text('Processing...');

    $.ajax({
        url: '{{ confirm_url }}',
        type: 'post',
        dataType: 'json',
        success: function(json) {
            if (json.redirect) {
                window.location = json.redirect;
            } else if (json.error) {
                btn.prop('disabled', false).html('<i class="fa-brands fa-bitcoin"></i> Pay with Crypto');
                alert(json.error);
            }
        },
        error: function() {
            btn.prop('disabled', false).html('<i class="fa-brands fa-bitcoin"></i> Pay with Crypto');
            alert('An error occurred. Please try again.');
        }
    });
});
</script>
